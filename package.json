{
  "name": "tree-paths",
  "description": "Convert a list of paths into a nested directory tree",
  "version": "1.0.0",
  "author": "Vlad Shcherbin <vlad.shcherbin@gmail.com>",
  "repository": "vladshcherbin/tree-paths",
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "lint": "eslint --flag unstable_native_nodejs_ts_config",
    "prepublishOnly": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "test": "node --test",
    "test:coverage": "node --test --experimental-test-coverage",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@shcherbin/eslint-config-node": "^0.6.0",
    "@shcherbin/typescript-config": "^1.0.0",
    "@types/node": "^26.0.1",
    "eslint": "^10.6.0",
    "tsdown": "^0.22.3",
    "typescript": "^6.0.3"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "tree",
    "treeify",
    "paths",
    "convert",
    "sort",
    "directory",
    "file",
    "nested"
  ],
  "sideEffects": false,
  "type": "module",
  "license": "MIT"
}
